{
	"name": "Mana",
	"author": "Original skin by JSO. Rewrite to update style and registration by Kenny2scratch. Contributions made from jvvg, blob8108, scmb1, -PRO-,",
	"url": "https://github.com/Spells-and-Guns/Mana",
	"descriptionmsg": "mana-desc",
	"namemsg": "skinname-mana",
	"license-name": "MIT",
	"type": "skin",
	"ValidSkinNames": {
		"mana": "Mana"
	},
	"AutoloadClasses": {
		"SkinMana": "SkinMana.php",
		"ManaTemplate": "ManaTemplate.php",
		"ManaHooks": "ManaHooks.php"
	},
	"Hooks": {
		"GetPreferences": "main",
		"OutputPageBodyAttributes": "main"
	},
	"HookHandlers": {
		"main": {
			"class": "ManaHooks",
			"services": ["UserOptionsLookup"]
		}
	},
	"MessagesDirs": {
		"Mana": "i18n"
	},
	"ResourceModules": {
		"skins.mana": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"content-links": true,
				"content-media": true,
				"interface-message-box": true,
				"interface-category": true,
				"content-tables": true,
				"i18n-ordered-lists": true,
				"i18n-all-lists-margins": true,
				"i18n-headings": true,
				"elements": true,
				"interface": true,
				"logo": true
			},
			"position": "top",
			"styles": {
				"resources/css/main.css": {
					"media": "screen"
				},
				"resources/css/dark.css": {
					"media": "screen"
				},
				"resources/css/mobile.css": {
					"media": "only screen and (max-width: 981.4px)"
				},
				"resources/css/mobile-40.css": {
					"media": "only screen and (max-width: 351.4px)"
				},
				"resources/css/mobile-30.css": {
					"media": "only screen and (max-width: 519.4px)"
				},
				"resources/css/mobile-20.css": {
					"media": "only screen and (min-width: 519.5px) and (max-width: 679.4px)"
				},
				"resources/css/mobile-10.css": {
					"media": "only screen and (min-width: 679.5px) and (max-width: 981.4px)"
				},
				"resources/css/mobile-00.css": {
					"media": "only screen and (min-width: 981.5px)"
				}
			}
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Mana"
	},
	"config": {
		"ManaJoinBox": {
			"value": true
		},
		"ManaForceDarkTheme": {
			"value": false
		},
		"ManaColors": {
			"value": {},
			"description": "CSS variables to override, e.g. { \"link-color\": \"255, 247, 0, 0.9\" }. See :root in resources/css/main.css for the full list."
		},
		"ManaBackground": {
			"value": null,
			"description": "URL of the page background image. null uses resources/background.webp."
		},
		"ManaHeaderLogo": {
			"value": null,
			"description": "URL of the big logo above the content. null uses resources/logo.png, false hides it. The small navbar logo comes from $wgLogos['wordmark']."
		},
		"ManaNavLogoLink": {
			"value": "https://www.spellsandguns.com/",
			"description": "Where the navbar logo links to. Empty links to the main page."
		},
		"ManaCursor": {
			"value": null,
			"description": "URL of a custom mouse cursor image. null keeps the normal cursor."
		},
		"ManaCursorLink": {
			"value": null,
			"description": "URL of a custom cursor image shown over links."
		},
		"ManaEditGuide": {
			"value": "Wiki_Editing",
			"description": "Page linked as the editing guide in the edit menu. Empty hides it."
		},
		"ManaFooterBanner": {
			"value": {
				"sng-footer-discord-cta": "https://discord.gg/wqRBSytTmP"
			},
			"merge_strategy": "provide_default",
			"description": "Bold line at the top of the footer, as { label: target }. Empty hides it."
		},
		"ManaFooterLinks": {
			"value": {
				"sng-footer-wiki-home": "/",
				"YouTube": "https://www.youtube.com/channel/UCpTRuIbbXl0C3503l-GT7Ug",
				"Discord": "https://discord.spellsandguns.com",
				"sng-footer-about-wiki": "About",
				"sng-footer-gaming-wikis": "https://spellsandguns.com/",
				"sng-footer-terms-of-use": "Term_of_Use",
				"sng-footer-privacy-policy": "Privacy_Policy",
				"sng-footer-copyright-policy": "https://creativecommons.org/licenses/by-sa/4.0/",
				"recentchanges": "Special:RecentChanges"
			},
			"merge_strategy": "provide_default",
			"description": "Footer links as { label: target }. A label that is a message key is translated; a target is a URL, an absolute path or a page name."
		}
	},
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.35.0"
	}
}
